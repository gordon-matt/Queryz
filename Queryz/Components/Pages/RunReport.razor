@page "/reports/{Id:int}"
@attribute [Authorize]

<PageTitle>@(result?.Name ?? "Run report") - Queryz</PageTitle>

<PageHeader Title="@(result?.Name ?? "Run report")" Description="The page shows the first rows. Download the file for the full report.">
    <Actions>
        <a class="nf-button" href="@($"/reports/{Id}/edit")">Edit</a>
        <button type="button" class="nf-button nf-button-danger" @onclick="DeleteAsync">Delete</button>
    </Actions>
</PageHeader>

@if (loading)
{
    <p class="nf-muted">Running.</p>
}
else if (error is not null)
{
    <EmptyState Icon="alert" Title="The report did not run" Description="@error" />
}
else if (result is not null)
{
    <p class="nf-muted">This is a preview of the first @(result.AppliedLimit ?? result.Rows.Count) rows. Download the file for the full report. A row limit saved on the report still applies to the download.</p>

    <form method="post" action="@($"/reports/{Id}/export")" class="queryz-fields" target="_blank">
        <Field Label="File format" For="download-format">
            <select id="download-format" name="FileFormat" class="nf-input" @bind="fileFormat">
                <option value="@DownloadFileFormat.Delimited">Delimited</option>
                <option value="@DownloadFileFormat.Xlsx">Excel (.xlsx)</option>
            </select>
        </Field>
        @if (fileFormat == DownloadFileFormat.Delimited)
        {
            <Field Label="Delimiter" For="download-delimiter">
                <select id="download-delimiter" name="Delimiter" class="nf-input" @bind="delimiter">
                    <option value="@DownloadFileDelimiter.Comma">Comma (,)</option>
                    <option value="@DownloadFileDelimiter.Tab">Tab</option>
                    <option value="@DownloadFileDelimiter.VerticalBar">Vertical bar (|)</option>
                    <option value="@DownloadFileDelimiter.Semicolon">Semicolon (;)</option>
                </select>
            </Field>
            <label class="nf-check">
                <input type="checkbox" name="AlwaysEnquote" value="true" @bind="alwaysEnquote" />
                <span>Always enquote</span>
            </label>
            <label class="nf-check">
                <input type="checkbox" name="OutputColumnNames" value="true" @bind="outputColumnNames" />
                <span>Output column names</span>
            </label>
        }
        <div>
            <button type="submit" class="nf-button nf-button-primary">Download</button>
        </div>
    </form>

    <p class="nf-hint">@result.Rows.Count rows in this preview.</p>
    <table class="nf-table">
        <thead>
            <tr>
                @foreach (string column in result.Columns)
                {
                    <th>@column</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in result.Rows)
            {
                <tr>
                    @foreach (string? value in row)
                    {
                        <td>@(value ?? "")</td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <details>
        <summary>Query</summary>
        <pre class="nf-mono">@result.Sql</pre>
    </details>
}
