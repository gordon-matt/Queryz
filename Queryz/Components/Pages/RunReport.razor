@page "/reports/{Id:int}"
@attribute [Authorize]

<PageTitle>@(setup?.Name ?? result?.Name ?? "Run report") - Queryz</PageTitle>

<PageHeader Title="@(setup?.Name ?? "Run report")" Description="@HeaderDescription">
    <Actions>
        @if (result is not null)
        {
            <button type="button" class="nf-icon-button" title="Download" aria-label="Download" @onclick="OpenDownload">
                <Icon Name="download" />
            </button>
        }
        @if (canManage)
        {
            <a class="nf-icon-button" href="@($"/reports/{Id}/edit")" title="Edit" aria-label="Edit">
                <Icon Name="edit" />
            </a>
            <button type="button" class="nf-icon-button nf-danger-hover" title="Delete" aria-label="Delete" @onclick="DeleteAsync">
                <Icon Name="trash" />
            </button>
        }
    </Actions>
</PageHeader>

@if (loading)
{
    <p class="nf-muted">Loading.</p>
}
else if (setup is null)
{
    <EmptyState Icon="alert" Title="The report could not be opened" Description="@error" />
}
else
{
    <section class="queryz-filters">
        <p class="nf-muted">The In operation takes several values separated by semicolons, with no spaces. Conditions hidden by the designer stay in effect.</p>
        <QueryBuilder @ref="filters" Config="filterConfig" @bind-Rules="rules" Theme="host" />
        <div>
            <button type="button" class="nf-button nf-button-primary" disabled="@running" @onclick="RunAsync">
                <Icon Name="play" />
                Run
            </button>
        </div>
    </section>

    @if (running)
    {
        <p class="nf-muted">Running.</p>
    }
    else if (runError is not null)
    {
        <EmptyState Icon="alert" Title="The report did not run" Description="@runError" />
    }
    else if (result is not null)
    {
        <p class="nf-muted">This is a preview of the first @(result.AppliedLimit ?? result.Rows.Count) rows.</p>

        <Drawer Title="Download" Open="downloadOpen" Scrim="true" OnClose="CloseDownload">
            <p class="nf-muted">The file includes the full report. A row limit saved on the report still applies.</p>
            <form method="post" action="@($"/reports/{Id}/export")" class="queryz-fields is-stack" target="_blank">
                <input type="hidden" name="RulesJson" value="@appliedRulesJson" />
                <Field Label="File format" For="download-format">
                    <select id="download-format" name="FileFormat" class="nf-input" @bind="fileFormat">
                        <option value="@DownloadFileFormat.Delimited">Delimited</option>
                        <option value="@DownloadFileFormat.Xlsx">Excel (.xlsx)</option>
                    </select>
                </Field>
                @if (fileFormat == DownloadFileFormat.Delimited)
                {
                    <Field Label="Delimiter" For="download-delimiter">
                        <select id="download-delimiter" name="Delimiter" class="nf-input" @bind="delimiter">
                            <option value="@DownloadFileDelimiter.Comma">Comma (,)</option>
                            <option value="@DownloadFileDelimiter.Tab">Tab</option>
                            <option value="@DownloadFileDelimiter.VerticalBar">Vertical bar (|)</option>
                            <option value="@DownloadFileDelimiter.Semicolon">Semicolon (;)</option>
                        </select>
                    </Field>
                    <label class="nf-check">
                        <input type="checkbox" name="AlwaysEnquote" value="true" @bind="alwaysEnquote" />
                        <span>Always enquote</span>
                    </label>
                    <label class="nf-check">
                        <input type="checkbox" name="OutputColumnNames" value="true" @bind="outputColumnNames" />
                        <span>Output column names</span>
                    </label>
                }
                <div>
                    <button type="submit" class="nf-button nf-button-primary">Download</button>
                </div>
            </form>
        </Drawer>

        <p class="nf-hint">@result.Rows.Count rows in this preview.</p>
        <table class="nf-table">
            <thead>
                <tr>
                    @foreach (string column in result.Columns)
                    {
                        <th>@column</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in result.Rows)
                {
                    <tr>
                        @foreach (string? value in row)
                        {
                            <td>@(value ?? "")</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (canManage)
        {
            <details>
                <summary>Query</summary>
                <pre class="nf-mono">@result.Sql</pre>
            </details>
        }
    }
}
