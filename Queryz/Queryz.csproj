<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Queryz</RootNamespace>
		<Description>Blazor report builder. Host it from an app that calls AddQueryz and supplies an IQueryzAuthorizationFilter.</Description>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Controllers\**" />
		<Compile Remove="Extensions\**" />
		<Compile Remove="Models\**" />
		<Compile Remove="Services\**" />
		<Compile Remove="IQueryzAssemblyMarker.cs" />
		<Content Remove="Views\**" />
		<None Remove="Views\**" />
		<Content Remove="wwwroot\js\**" />
		<Content Remove="wwwroot\jQuery-QueryBuilder\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ardalis.Result" Version="10.1.0" />
		<PackageReference Include="Heroicsoft.NetForge.Authentication" Version="1.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Queryz.Core\Queryz.Core.csproj" />
		<ProjectReference Include="..\Queryz.Data\Queryz.Data.csproj" />
		<ProjectReference Include="..\Queryz.Data.MySql\Queryz.Data.MySql.csproj" />
		<ProjectReference Include="..\Queryz.Data.Npgsql\Queryz.Data.Npgsql.csproj" />
		<ProjectReference Include="..\Queryz.Data.Sql\Queryz.Data.Sql.csproj" />
		<ProjectReference Include="..\Queryz.Data.Sqlite\Queryz.Data.Sqlite.csproj" />
		<ProjectReference Include="..\Queryz.Models\Queryz.Models.csproj" />
		<ProjectReference Include="..\Queryz.Services\Queryz.Services.csproj" />
		<ProjectReference Include="..\..\..\Libraries\Heroicsoft.NetForge\Heroicsoft.NetForge.Components\Heroicsoft.NetForge.Components.csproj" />
		<ProjectReference Include="..\..\..\Components\QueryKrafter\QueryKrafter.Components\QueryKrafter.Components.csproj" />
	</ItemGroup>

</Project>
